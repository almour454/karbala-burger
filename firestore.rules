rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public data — menu, settings — anyone can read, only auth can write
    match /artifacts/{appId}/public/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Orders — anonymous users CAN write (they have auth.uid)
    match /artifacts/{appId}/private/data/orders/{dateStr}/items/{orderId} {
      allow read, write: if request.auth != null;
    }

    // Order counter + confirmed meta
    match /artifacts/{appId}/private/data/orders/{dateStr}/meta/{metaId} {
      allow read, write: if request.auth != null;
    }

    // Admin — owner only
    match /artifacts/{appId}/private/data/admin/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}